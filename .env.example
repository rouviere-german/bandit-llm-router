# Copy to .env for local runs. Never commit .env. Every variable is optional, and the defaults are
# the ones the tests, the demo and the benches run with -- all of them offline.
# tests/unit/test_config.py asserts this file documents every field of Settings.

# --- service ---
APP_SERVICE_NAME=bandit-llm-router
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false
APP_DATA_DIR=var

# --- HTTP hardening ---
# Comma-separated lowercase SHA-256 digests. This list is what /metrics and the per-key rate limiter
# check; the scoped lists below are what the routing, feedback and governance routes check.
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# --- scoped API keys -------------------------------------------------------------------------------
# Four separate lists, because the four things a caller can do have very different blast radii:
# route spends a tenant's budget, feedback steers what the policy learns, admin proposes and
# activates policies, and approve signs off on someone else's activation. Separation of duties in
# the activation gate is only meaningful if these are held by different principals.
# Generate one with: uv run bandit-llm-router generate-api-key --scope route
APP_ROUTE_API_KEY_SHA256=
APP_FEEDBACK_API_KEY_SHA256=
APP_ADMIN_API_KEY_SHA256=
APP_APPROVER_API_KEY_SHA256=

# --- featurizer ------------------------------------------------------------------------------------
# Prompts are never stored; what identifies a context in the log is a keyed BLAKE2b digest. With no
# key, the digest of a short prompt is guessable by enumerating candidates -- set this in any
# deployment where that matters (docs/THREAT_MODEL.md).
APP_FEATURE_DIGEST_KEY=
# Routing arms and their token prices. Models are checked against the pinned allowlist at load time.
APP_PRICING_PATH=config/pricing.toml

# --- policy ----------------------------------------------------------------------------------------
# linucb | thompson | epsilon_greedy. Everything here is part of the policy version, so a logged
# decision can always be traced back to the configuration that produced it.
APP_POLICY_KIND=linucb
APP_POLICY_ALPHA=0.5
APP_POLICY_EPSILON=0.05
APP_POLICY_POSTERIOR_SD=0.3
APP_POLICY_MC_SAMPLES=24
APP_POLICY_RIDGE=1.0
# Below 1.0 the posteriors forget old evidence, which is how the router survives a model update that
# changes an arm's quality. 1.0 is stationary.
APP_POLICY_DISCOUNT=1.0
# Every arm keeps at least this much probability. This is the price of being able to evaluate a
# successor policy at all: at zero, no other policy can ever be estimated from these logs.
APP_PROPENSITY_FLOOR=0.02

# --- the cost-quality trade-off --------------------------------------------------------------------
# reward = clip(quality - cost_weight * min(1, cost / cost_reference), 0, 1). Changing either number
# changes what "better" means, so both are part of the policy version.
APP_REWARD_COST_WEIGHT=0.5
APP_REWARD_COST_REFERENCE_MICROS=14000

# --- per-tenant budgets ----------------------------------------------------------------------------
APP_TENANT_BUDGET_USD=5.0
# Per-tenant overrides, e.g. "tenant_a:10,tenant_b:2".
APP_TENANT_BUDGET_CAPS=
APP_TENANT_BUDGET_WINDOW_SECONDS=86400

# --- feedback --------------------------------------------------------------------------------------
APP_FEEDBACK_RATE_LIMIT_PER_SECOND=20
APP_FEEDBACK_RATE_LIMIT_BURST=60
APP_FEEDBACK_TTL_SECONDS=86400
APP_FEEDBACK_MAX_REPORTS_PER_DECISION=8

# --- circuit breaker -------------------------------------------------------------------------------
APP_BREAKER_FAILURE_THRESHOLD=3
APP_BREAKER_COOLDOWN_SECONDS=30

# --- OPE screening and tracking --------------------------------------------------------------------
# A candidate needs this much effective sample size before its estimate counts as evidence.
APP_SCREENING_MIN_ESS=500
APP_SCREENING_HORIZON_REQUESTS=100000
APP_SCREENING_MAX_EXPLORATION_USD=250
# The gate screens on the log the live policy wrote *while it was learning*, so its rows are not
# independent. The bootstrap behind the DR lower bound therefore resamples contiguous blocks of this
# many rows. Set to 1 to opt back into the plain row bootstrap.
APP_SCREENING_BOOTSTRAP_BLOCK_SIZE=250
APP_MLFLOW_DIR=var/mlflow

# --- the live provider -----------------------------------------------------------------------------
# With no key the router serves from a seeded offline provider: the tests, the demo and the benches
# all run that way and never spend anything.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true

# --- the LLM spend ledger (recorded live runs) -----------------------------------------------------
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0
